# Copy this file to .env.local and fill in the values. Never commit real values.
# Production uses .env.prod on the VM (see docs/implementation/01. general_implementation.md section 6).

# --- App ---
# Public address of the site
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database ---
# Passwords used by docker/postgres/init to create the four database roles
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_REALTIME_PASSWORD=
DB_RETENTION_PASSWORD=
# App role (read and write, no changes to the audit log or messages)
DATABASE_URL=postgresql://offload_app:PASSWORD@127.0.0.1:5433/offload
# Owner role, used only by migrations and the seed
DATABASE_URL_OWNER=postgresql://offload_owner:PASSWORD@127.0.0.1:5433/offload
# Read-only role for the realtime server
DATABASE_URL_REALTIME=postgresql://offload_realtime:PASSWORD@127.0.0.1:5433/offload
# Role that may delete old audit events
DATABASE_URL_RETENTION=postgresql://offload_retention:PASSWORD@127.0.0.1:5433/offload

# --- Our own secrets (32+ random bytes each) ---
BETTER_AUTH_SECRET=
JOB_SECRET=

# --- Drivers ---
# STORAGE_DRIVER: local (files in LOCAL_STORAGE_DIR) or gcs
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.local-storage
# EMAIL_DRIVER: log or smtp2go
EMAIL_DRIVER=log
# OUTBOUND_MODE: redirect (all email to OUTBOUND_REDIRECT_EMAIL, no newsletter calls) or live
OUTBOUND_MODE=redirect
OUTBOUND_REDIRECT_EMAIL=

# --- Google reCAPTCHA v3 (empty = check skipped outside production) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Google Cloud Storage (STORAGE_DRIVER=gcs) ---
GCP_PROJECT_ID=
GCS_UPLOADS_BUCKET=
GCS_USER_CONTENT_BUCKET=
# Local development only. On the VM the attached service account is used.
GOOGLE_APPLICATION_CREDENTIALS=

# --- SMTP2GO (EMAIL_DRIVER=smtp2go) ---
SMTP2GO_API_KEY=
SMTP2GO_WEBHOOK_SECRET=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Offload

# --- Kit newsletter ---
KIT_API_KEY=
KIT_WEBHOOK_SECRET=
KIT_TAG_ID=

# --- Google Maps Platform ---
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_SERVER_KEY=

# --- GlitchTip (empty = off) ---
NEXT_PUBLIC_GLITCHTIP_DSN=
GLITCHTIP_DSN=

# --- Realtime chat server ---
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001/ws
REALTIME_PORT=3001
