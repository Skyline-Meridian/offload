{
  "name": "offload",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.22.3"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:realtime": "tsx --conditions=react-server --env-file=.env.local --watch realtime/server.ts",
    "dev:worker": "tsx --conditions=react-server --env-file=.env.local --watch worker/index.ts",
    "build": "prisma generate && next build",
    "build:workers": "node scripts/build-workers.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests --project integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local prisma/seed.ts",
    "db:up": "docker compose --env-file .env.local -f compose.yaml -f compose.local.yaml up -d db",
    "db:down": "docker compose --env-file .env.local -f compose.yaml -f compose.local.yaml down"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@google-cloud/storage": "9.0.0",
    "@googlemaps/js-api-loader": "2.1.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "11.20.0",
    "@sentry/node": "11.20.0",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/extension-link": "3.35.1",
    "@tiptap/pm": "3.35.1",
    "@tiptap/react": "3.35.1",
    "@tiptap/starter-kit": "3.35.1",
    "better-auth": "1.7.28",
    "clsx": "2.1.1",
    "croner": "11.0.1",
    "date-fns": "4.4.0",
    "heic-decode": "2.1.0",
    "i18n-iso-countries": "7.14.0",
    "libphonenumber-js": "1.13.17",
    "lucide-react": "1.83.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-aria-components": "1.22.1",
    "react-dom": "19.2.4",
    "recharts": "3.11.2",
    "sanitize-html": "2.18.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.2.0",
    "tailwind-merge": "3.7.1",
    "vanilla-cookieconsent": "3.3.0",
    "ws": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "3.67.0",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "mysql2": "^3.24.6",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "sharp@0.35.5": true,
    "esbuild@0.28.2": true,
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
